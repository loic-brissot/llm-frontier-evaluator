{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/log-tool-event.py",
        "timeout": 5,
        "failClosed": false
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/log-tool-event.py",
        "timeout": 5,
        "failClosed": false
      }
    ],
    "postToolUseFailure": [
      {
        "command": ".cursor/hooks/log-tool-event.py",
        "timeout": 5,
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/log-tool-event.py",
        "timeout": 5,
        "failClosed": false
      }
    ]
  }
}
