# Benchmark API Credentials
# Copy this file to .env and fill in the keys for the harnesses you plan to test:
#   cp .env.example .env

# Cursor Harness
# Generate an API key from the Cursor settings/dashboard.
CURSOR_API_KEY=
# Or provide a path to a key file on disk:
# CURSOR_API_KEY_FILE=~/.cursor/api-key.txt

# Claude Code Harness
# Preferred: Pro/Max/Team subscription token (generate once with `claude setup-token`).
# When set, it is used INSTEAD of ANTHROPIC_API_KEY (the key is never forwarded to the container),
# and a rejected/expired token fails the run rather than falling back to per-token API billing.
CLAUDE_CODE_OAUTH_TOKEN=
# Fallback: Anthropic API key (per-token API billing). Only used when CLAUDE_CODE_OAUTH_TOKEN is empty.
ANTHROPIC_API_KEY=
# Or provide a path to a key file on disk:
# ANTHROPIC_API_KEY_FILE=~/.anthropic/api-key.txt
