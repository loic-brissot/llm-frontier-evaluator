# Benchmark API Credentials
# Copy this file to .env and fill in the keys for the harnesses you plan to test:
#   cp .env.example .env

# Cursor Harness
# Generate an API key from the Cursor settings/dashboard.
CURSOR_API_KEY=
# Or provide a path to a key file on disk:
# CURSOR_API_KEY_FILE=~/.cursor/api-key.txt

# Claude Code Harness
# Anthropic API key for evaluating models via Claude Code.
ANTHROPIC_API_KEY=
# Or provide a path to a key file on disk:
# ANTHROPIC_API_KEY_FILE=~/.anthropic/api-key.txt
