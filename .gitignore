.DS_Store
__pycache__/
*.pyc
.venv/

# Local environment variables and secrets
.env
.env.*
!.env.example

# The atlas a model builds, and the open-data files it downloads.
# Metrics and notes stay in git. The build does not.
runs/*/*/workspace/
runs/*/*/.staging_workspace
tmp/*

# Tool-event logs can contain command output and file contents.
# Counts from a run are copied into run.json.
.cursor/tool-events/
runs/*/*/tool-events/

# Local analytical warehouse files and DuckDB databases
warehouse/*
!warehouse/README.md
*.duckdb
*.duckdb.wal
*.egg-info/
