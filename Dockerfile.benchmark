FROM node:22-bookworm

# Install required system packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-pip \
    git \
    curl \
    jq \
    unzip \
    sqlite3 \
    ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt-get/lists/*

# Install Claude Code globally via npm
RUN npm install -g @anthropic-ai/claude-code

# Reconfigure UID 1000 user as 'benchmark' with home /home/benchmark
RUN if id -u node >/dev/null 2>&1; then \
        usermod -l benchmark -d /home/benchmark -m node && \
        groupmod -n benchmark node ; \
    else \
        useradd -m -s /bin/bash -u 1000 benchmark ; \
    fi

# Pre-create clean-room directories under /home/benchmark
RUN mkdir -p /home/benchmark/.cursor/skills \
             /home/benchmark/.cursor/plugins \
             /home/benchmark/.claude \
             /home/benchmark/.local/bin \
    && chown -R benchmark:benchmark /home/benchmark

# Provide cursor-agent helper / installer path in PATH if not installed via curl
RUN echo '#!/bin/sh\nif command -v cursor-agent >/dev/null 2>&1; then exec cursor-agent "$@"; else echo "cursor-agent not installed or installer path missing" >&2; exit 1; fi' > /usr/local/bin/cursor-agent \
    && chmod +x /usr/local/bin/cursor-agent

# Create staged workspace directory owned by benchmark
RUN mkdir -p /workspace && chown benchmark:benchmark /workspace

WORKDIR /workspace
USER benchmark
