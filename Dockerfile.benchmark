FROM node:22-bookworm

ARG CURSOR_AGENT_VERSION=2026.10.19-6bbf2c4
ARG CLAUDE_CODE_VERSION=latest

# Install required system packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-pip \
    git \
    curl \
    jq \
    unzip \
    sqlite3 \
    ca-certificates \
    build-essential \
    libnspr4 \
    libnss3 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libatspi2.0-0 \
    libcups2 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libxkbcommon0 \
    libasound2 \
    && rm -rf /var/lib/apt-get/lists/*

# Install Claude Code and Playwright globally via npm, and Python Playwright
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} playwright \
    && pip3 install --no-cache-dir --break-system-packages playwright

# Reconfigure UID 1000 user as 'benchmark' with home /home/benchmark
RUN if id -u node >/dev/null 2>&1; then \
        usermod -l benchmark -d /home/benchmark -m node && \
        groupmod -n benchmark node ; \
    else \
        useradd -m -s /bin/bash -u 1000 benchmark ; \
    fi

# Pre-create clean-room directories under /home/benchmark and configure environment
ENV PATH="/home/benchmark/.local/bin:${PATH}"
ENV PLAYWRIGHT_BROWSERS_PATH="/home/benchmark/.cache/ms-playwright"
ENV NODE_PATH="/usr/local/lib/node_modules"

RUN mkdir -p /home/benchmark/.cursor/skills \
             /home/benchmark/.cursor/plugins \
             /home/benchmark/.claude \
             /home/benchmark/.local/bin \
             /home/benchmark/.cache/ms-playwright \
             /home/benchmark/.local/share/cursor-agent/versions/default \
    && chown -R benchmark:benchmark /home/benchmark

# Install cursor-agent for user benchmark
USER benchmark
RUN mkdir -p /home/benchmark/.local/share/cursor-agent/versions/default \
    && ARCH="$(uname -m)" \
    && if [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then CURSOR_ARCH="arm64"; else CURSOR_ARCH="x64"; fi \
    && curl -fSL "https://downloads.cursor.com/lab/${CURSOR_AGENT_VERSION}/linux/${CURSOR_ARCH}/agent-cli-package.tar.gz" \
    | tar --strip-components=1 -xzf - -C /home/benchmark/.local/share/cursor-agent/versions/default \
    && ln -s /home/benchmark/.local/share/cursor-agent/versions/default/cursor-agent /home/benchmark/.local/bin/agent \
    && ln -s /home/benchmark/.local/share/cursor-agent/versions/default/cursor-agent /home/benchmark/.local/bin/cursor-agent

# Pre-install Playwright Chromium in user cache
RUN playwright install chromium

# Create staged workspace directory owned by benchmark
USER root
RUN mkdir -p /workspace && chown benchmark:benchmark /workspace

WORKDIR /workspace
USER benchmark
