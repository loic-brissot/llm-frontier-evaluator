{
  "adaptive-endurance-coach": {
    "prompt_id": "adaptive-endurance-coach",
    "type": "domain_model",
    "description": "Adaptive endurance training planner and physiological simulator",
    "checks": [
      {
        "id": "banister_ewma_model",
        "description": "Banister impulse-response model constants (CTL 42d EWMA, ATL 7d EWMA, TSB = CTL - ATL)",
        "required_markers": ["42", "7", "TSB"],
        "min_records": 1
      },
      {
        "id": "coggan_power_tss_model",
        "description": "Coggan power zones & TSS formula (FTP, NP, IF, 3600s denominator)",
        "required_markers": ["FTP", "NP", "IF", "3600"],
        "min_records": 1
      },
      {
        "id": "daniels_vdot_css_model",
        "description": "Daniels VDOT running zones & Critical Swim Speed formula (CSS, 400, 200)",
        "required_markers": ["CSS", "400", "200"],
        "min_records": 1
      },
      {
        "id": "export_formats_support",
        "description": "Calendar (.ics) and Zwift workout (.zwo) export implementation",
        "file_patterns": ["*.ics", "*.zwo", "*export*", "*zwo*", "*ics*"],
        "required_markers": ["ics", "zwo"],
        "min_records": 1
      },
      {
        "id": "endurance_disciplines",
        "description": "Four endurance disciplines (triathlon, running, cycling, cross-training)",
        "required_markers": ["triathlon", "running", "cycling"],
        "min_records": 1
      }
    ],
    "synthetic_patterns": []
  },
  "france-electricity-carbon-flow": {
    "prompt_id": "france-electricity-carbon-flow",
    "type": "open_data",
    "description": "French electricity system observatory and carbon flow simulator",
    "checks": [
      {
        "id": "regions_dataset",
        "description": "12 French administrative regions boundaries or dataset",
        "file_patterns": ["*region*", "*eco2mix*", "*contours*"],
        "required_markers": ["region", "code", "nom"],
        "min_records": 12
      },
      {
        "id": "eco2mix_timeseries_dataset",
        "description": "eCO2mix national/regional generation time series with technology mix & carbon intensity",
        "file_patterns": ["*eco2mix*", "*generation*", "*mix*", "*carbon*"],
        "required_markers": ["nucleaire", "hydro", "eolien", "solaire", "co2"],
        "min_records": 100
      },
      {
        "id": "power_plants_registry_dataset",
        "description": "National registry of power plants and storage facilities with MW capacity",
        "file_patterns": ["*registre*", "*installation*", "*centrale*", "*power*"],
        "required_markers": ["mw", "capacite", "technologie"],
        "min_records": 50
      },
      {
        "id": "cross_border_interconnections",
        "description": "Cross-border interconnections with neighboring countries (UK, BE, DE, CH, IT, ES)",
        "required_markers": ["royaume-uni", "belgique", "allemagne", "suisse", "italie", "espagne"],
        "min_records": 1
      }
    ],
    "synthetic_patterns": [
      "generateMockGrid",
      "fakePowerPlants",
      "mockEco2mix",
      "generateRandomPower"
    ]
  },
