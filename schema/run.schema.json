{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/llm-frontier-evaluator/run.schema.json",
  "title": "LLM frontier evaluator run",
  "description": "One model attempt on one prompt in prompt/ (prompt_id is the file stem). Metric rules_version 2; records made under rules_version 1 still validate. scripts/compare_runs.py validates every run.json against this schema, and scripts/run_common.py reads its enums and defaults from $defs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rules_version",
    "run_id",
    "series_id",
    "prompt_id",
    "prompt_sha256",
    "shot",
    "parent_run_id",
    "model",
    "harness",
    "wall_clock",
    "tokens",
    "model_time",
    "tool_calls",
    "context_reread",
    "outcome",
    "observations"
  ],
  "properties": {
    "rules_version": {
      "enum": [1, 2],
      "default": 2,
      "description": "Version of docs/metrics.md and docs/tool-buckets.md the record follows. The default is the current version; older records keep theirs."
    },
    "run_id": {"type": "string", "minLength": 1},
    "series_id": {"type": "string", "minLength": 1},
    "prompt_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Stem of the prompt file: prompt/<prompt-id>.txt. The run lives in runs/<prompt-id>/<run-id>/."
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the exact bytes of prompt/<prompt-id>.txt at setup time."
    },
    "shot": {"enum": ["primary", "follow-up"], "default": "primary"},
    "parent_run_id": {
      "type": ["string", "null"],
      "default": null,
      "description": "Null on a primary run. The primary run id on a follow-up."
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "context": {
          "type": ["string", "null"],
          "minLength": 1,
          "default": null,
          "description": "Optional context size, e.g. 500k. Cursor runs only. A missing key reads as null."
        },
        "reasoning": {"$ref": "#/$defs/reasoningLevel"}
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "detail"],
      "properties": {
        "name": {"$ref": "#/$defs/harnessName"},
        "version": {"type": ["string", "null"], "default": null},
        "detail": {"type": "string", "default": ""}
      }
    },
    "wall_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at"],
      "properties": {
        "started_at": {"type": ["string", "null"], "format": "date-time", "default": null},
        "ended_at": {"type": ["string", "null"], "format": "date-time", "default": null}
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split_rule", "reasoning_tokens", "visible_tokens", "raw"],
      "properties": {
        "split_rule": {"$ref": "#/$defs/splitRule"},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0, "default": null},
        "visible_tokens": {"type": ["integer", "null"], "minimum": 0, "default": null},
        "raw": {"type": "object", "default": {}}
      },
      "if": {"properties": {"split_rule": {"const": "unavailable"}}},
      "then": {
        "properties": {
          "reasoning_tokens": {"type": "null"},
          "visible_tokens": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "reasoning_tokens": {"type": "integer"},
          "visible_tokens": {"type": "integer"}
        }
      }
    },
    "model_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "generating_seconds", "raw"],
      "properties": {
        "source": {"$ref": "#/$defs/modelTimeSource"},
        "generating_seconds": {"type": ["number", "null"], "minimum": 0, "default": null},
        "raw": {"type": "object", "default": {}}
      },
      "if": {"properties": {"source": {"const": "unavailable"}}},
      "then": {"properties": {"generating_seconds": {"type": "null"}}},
      "else": {"properties": {"generating_seconds": {"type": "number"}}}
    },
    "tool_calls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shell", "files", "visual_checks", "web", "other"],
      "properties": {
        "shell": {"$ref": "#/$defs/bucket"},
        "files": {"$ref": "#/$defs/bucket"},
        "visual_checks": {"$ref": "#/$defs/bucket"},
        "web": {"$ref": "#/$defs/bucket"},
        "other": {"$ref": "#/$defs/bucket"}
      }
    },
    "context_reread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "cache_read_tokens",
        "cache_write_tokens",
        "uncached_input_tokens",
        "raw"
      ],
      "properties": {
        "source": {"$ref": "#/$defs/cacheSource"},
        "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0, "default": null},
        "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0, "default": null},
        "uncached_input_tokens": {"type": ["integer", "null"], "minimum": 0, "default": null},
        "raw": {"type": "object", "default": {}}
      },
      "if": {"properties": {"source": {"const": "unavailable"}}},
      "then": {"properties": {"cache_read_tokens": {"type": "null"}}},
      "else": {"properties": {"cache_read_tokens": {"type": "integer"}}}
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_stopped", "operator_saw_a_page", "summary"],
      "properties": {
        "model_stopped": {"type": ["boolean", "null"], "default": null},
        "operator_saw_a_page": {"type": ["boolean", "null"], "default": null},
        "summary": {"type": "string", "default": ""}
      }
    },
    "observations": {"type": "string", "default": ""},
    "verification": {
      "type": ["object", "null"],
      "default": null,
      "additionalProperties": true,
      "properties": {
        "runtime": {
          "type": ["object", "null"],
          "default": null,
          "additionalProperties": true,
          "properties": {
            "passed": {"type": "boolean"},
            "http_status": {"type": ["integer", "null"]},
            "url": {"type": "string"},
            "server_mode": {
              "type": "string",
              "enum": ["static", "command", "external_url", "none"]
            },
            "load_time_ms": {"type": ["number", "null"]},
            "console_errors": {
              "type": "array",
              "items": {"type": "string"}
            },
            "console_warnings_count": {"type": "integer", "minimum": 0},
            "page_errors": {
              "type": "array",
              "items": {"type": "string"}
            },
            "failed_requests": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "url": {"type": "string"},
                  "reason": {"type": "string"},
                  "status": {"type": ["integer", "null"]}
                }
              }
            },
            "dom": {
              "type": ["object", "null"],
              "additionalProperties": true,
              "properties": {
                "title": {"type": "string"},
                "canvas_count": {"type": "integer", "minimum": 0},
                "svg_count": {"type": "integer", "minimum": 0},
                "webgl_context": {"type": "boolean"},
                "text_length": {"type": "integer", "minimum": 0}
              }
            },
            "screenshot_path": {"type": ["string", "null"]},
            "verified_at": {"type": "string"}
          }
        },
        "data_pipeline": {
          "type": ["object", "null"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"shot": {"const": "primary"}}},
      "then": {"properties": {"parent_run_id": {"type": "null"}}},
      "else": {"properties": {"parent_run_id": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {
        "required": ["model_time"],
        "properties": {
          "model_time": {
            "required": ["source"],
            "properties": {"source": {"const": "wall_clock_minus_tool_time"}}
          }
        }
      },
      "then": {"properties": {"rules_version": {"const": 2}}}
    },
    {
      "if": {
        "required": ["harness"],
        "properties": {"harness": {"required": ["name"], "properties": {"name": {"const": "cursor"}}}}
      },
      "then": {
        "properties": {
          "model": {
            "properties": {
              "reasoning": {
                "anyOf": [{"$ref": "#/$defs/cursorReasoning"}, {"$ref": "#/$defs/unsetReasoning"}]
              }
            }
          }
        }
      },
      "else": {"properties": {"model": {"properties": {"context": {"type": "null"}}}}}
    },
    {
      "if": {
        "required": ["harness"],
        "properties": {"harness": {"required": ["name"], "properties": {"name": {"const": "claude-code"}}}}
      },
      "then": {
        "properties": {
          "model": {
            "properties": {
              "reasoning": {
                "anyOf": [{"$ref": "#/$defs/claudeCodeReasoning"}, {"$ref": "#/$defs/unsetReasoning"}]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "harnessName": {
      "enum": ["cursor", "claude-code", "codex", "other"],
      "default": "cursor"
    },
    "reasoningLevel": {
      "description": "Optional effort level, from any harness list below. When it is not set, it defaults to unknown; null and a missing key read as the same not-set value.",
      "type": ["string", "null"],
      "enum": ["minimal", "low", "medium", "high", "xhigh", "ultra", "max", "ultracode", "none", "unknown", null],
      "default": "unknown"
    },
    "cursorReasoning": {
      "description": "Effort levels the Cursor harness proposes, in its order.",
      "enum": ["minimal", "low", "medium", "high", "xhigh", "max"]
    },
    "claudeCodeReasoning": {
      "description": "Effort levels the Claude Code harness proposes, in its order.",
      "enum": ["low", "medium", "high", "ultra", "max", "ultracode"]
    },
    "defaultReasoning": {
      "description": "Effort levels setup_run.py proposes for harnesses without their own list (codex, other). Those harnesses accept any reasoningLevel.",
      "enum": ["low", "medium", "high", "xhigh", "none", "unknown"]
    },
    "unsetReasoning": {
      "description": "Accepted for every harness: unknown is the not-set default, null means the same, and none is a legacy value from runs recorded before the per-harness lists.",
      "enum": ["none", "unknown", null]
    },
    "splitRule": {
      "enum": [
        "output_includes_reasoning",
        "output_excludes_reasoning",
        "harness_pre_split",
        "unavailable"
      ],
      "default": "unavailable"
    },
    "modelTimeSource": {
      "description": "wall_clock_minus_tool_time is rules_version 2 only.",
      "enum": [
        "harness_model_time",
        "sum_of_llm_request_durations",
        "wall_clock_minus_tool_time",
        "unavailable"
      ],
      "default": "unavailable"
    },
    "cacheSource": {
      "enum": ["provider_cache_read", "unavailable"],
      "default": "unavailable"
    },
    "bucket": {
      "description": "Calls and failures are set together. A null bucket has an empty by_tool. Failures within calls and by_tool sums are checked by compare_runs.py.",
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "failures", "by_tool"],
      "properties": {
        "calls": {"type": ["integer", "null"], "minimum": 0, "default": null},
        "failures": {"type": ["integer", "null"], "minimum": 0, "default": null},
        "by_tool": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/toolCount"},
          "default": {}
        }
      },
      "if": {"properties": {"calls": {"type": "null"}}},
      "then": {"properties": {"failures": {"type": "null"}, "by_tool": {"maxProperties": 0}}},
      "else": {"properties": {"failures": {"type": "integer"}}}
    },
    "toolCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "failures"],
      "properties": {
        "calls": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0}
      }
    }
  }
}
